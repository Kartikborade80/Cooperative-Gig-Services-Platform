PROJECT_NAME="Cooperative Gig Services Platform"
ENVIRONMENT="production"
DEBUG=False

# Database Configuration
# PostgreSQL Production Example:
DATABASE_URL="postgresql+psycopg2://postgres:your_secure_password@localhost:5432/coop_gig_db"
# Or SQLite Development Default:
# DATABASE_URL="sqlite:///./coop_gig.db"

# Security & JWT
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cooperative Defaults
DEFAULT_COOP_NAME="Shramik Sahakari Labour Cooperative Federation"
COOP_COMMISSION_PERCENTAGE=5.0
WORKER_SHARE_PERCENTAGE=95.0

# CORS Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
